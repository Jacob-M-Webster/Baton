# Copy to .env and fill in what you have. Every provider is optional:
# with none configured, the offline demo model still works.

# Claude (Anthropic Messages API)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# ANTHROPIC_SUMMARY_MODEL=claude-haiku-5-5

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODELS=gpt-5,gpt-5-mini
# OPENAI_SUMMARY_MODEL=gpt-5-mini

# Google Gemini (native Gemini API). With a key set, the model menu lists every chat model it can use.
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-pro,gemini-2.5-flash
# GEMINI_SUMMARY_MODEL=gemini-3.8-flash

# xAI Grok (OpenAI-compatible API at api.x.ai). With a key set, the model menu lists every Grok chat model it can use.
XAI_API_KEY=
# XAI_MODELS=grok-4,grok-code-fast-1
# XAI_SUMMARY_MODEL=          # defaults to the session's model

# Local weights: any OpenAI-compatible server (Ollama, vLLM, LM Studio, llama.cpp).
# Models are discovered from {LOCAL_BASE_URL}/models.
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_CONTEXT_WINDOW=32768

# Billing with Stripe (optional). With a key set, real models need a Team or Enterprise subscription;
# the offline demo stays free. Use test keys (sk_test_...) until you're ready to charge.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=      # from `python scripts/stripe_setup.py webhook https://your-host`
# BATON_TEAM_SEAT_CENTS=2500        # Team: $25 per seat per month, billed monthly
# BATON_ENTERPRISE_SEAT_CENTS=5000  # Enterprise: $50 per seat per month, billed annually
# BATON_ENTERPRISE_MIN_SEATS=50
# BATON_BILLING_REQUIRED=0    # 1: real models need an active subscription (off for now)

# Server
# BATON_PORT=8000
# BATON_DATA_DIR=./data
# BATON_DEMO_SPEED=1.0        # pacing of the offline demo model (2 = twice as fast)
# BATON_SANDBOX=local         # or docker / podman: run agent commands in a container with no network
# BATON_ACCESS_CODE=          # require this shared code to use the API (always set when hosting)
# BATON_BASH=                 # Windows: bash.exe for agent/terminal commands (default: Git for Windows' bash)
# BATON_DRIVER_IDLE_SECONDS=120
# BATON_CATCHUP_MIN_SECONDS=120   # at most one catch-up summary request per session this often
# BATON_CATCHUP_REFRESH_EVENTS=15 # how many new events make a catch-up summary worth redoing
# GITHUB_TOKEN=               # read access to private repos for "Start from a GitHub repository"
# SLACK_WEBHOOK_URL=          # ping a channel when the agent needs a decision or finishes
