# Copy to .env and fill in what you have. Every provider is optional:
# with none configured, the offline demo model still works.

# Claude (Anthropic Messages API)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# ANTHROPIC_SUMMARY_MODEL=claude-haiku-5-5

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODELS=gpt-5,gpt-5-mini
# OPENAI_SUMMARY_MODEL=gpt-5-mini

# Google Gemini (native Gemini API). With a key set, the model menu lists every chat model it can use.
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-pro,gemini-2.5-flash   # shown first, and used if listing fails
# GEMINI_SUMMARY_MODEL=gemini-2.5-flash-lite

# Local weights: any OpenAI-compatible server (Ollama, vLLM, LM Studio, llama.cpp).
# Models are discovered from {LOCAL_BASE_URL}/models.
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_CONTEXT_WINDOW=32768

# Server
# BATON_PORT=8000
# BATON_DATA_DIR=./data
# BATON_DEMO_SPEED=1.0        # pacing of the offline demo model (2 = twice as fast)
# BATON_SANDBOX=local         # or docker / podman: run agent commands in a container with no network
# BATON_ACCESS_CODE=          # require this shared code to use the API (always set when hosting)
# BATON_BASH=                 # Windows: bash.exe for agent/terminal commands (default: Git for Windows' bash)
# BATON_DRIVER_IDLE_SECONDS=120
# SLACK_WEBHOOK_URL=          # ping a channel when the agent needs a decision or finishes
