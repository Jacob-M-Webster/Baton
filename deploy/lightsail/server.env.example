# Settings for the Baton server on Lightsail. deploy.sh copies this to deploy/lightsail/server.env
# (gitignored) on first run, with a random access code; edit that copy, not this file.

# Required. Anyone with this code can join, steer and (as driver) run commands on the server.
BATON_ACCESS_CODE=

# Models. Every provider is optional; the offline demo model always works.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional. Read access to private GitHub repositories for new sessions.
GITHUB_TOKEN=

# Billing (optional): Stripe test keys first. See "Billing" in the main README.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# BATON_PLAN_PRICE_CENTS=2900

# Optional
# SLACK_WEBHOOK_URL=          # ping a channel when the agent needs a decision or finishes
# BATON_DEMO_SPEED=1.0
